# Where the partner API is. The mock server listens here by default.
PARTNER_API_BASE_URL=http://127.0.0.1:4010
# Your key. This one is built into the mock server; a real restaurant gives you a real one.
PARTNER_API_KEY=hbk_test_mockfull0001_fullscopes

# The webhook receiver (npm run receiver). The first port takes deliveries and is the only one to expose;
# the second is the local control port and must stay on this machine.
# WEBHOOK_PORT=4020
# WEBHOOK_CONTROL_PORT=4021
# The pages allowed to use the control port from a browser, comma-separated. The default is the demo's two
# addresses on port 5180. If the demo started on another port (5180 was taken), put the address it printed here.
# WEBHOOK_ALLOWED_ORIGINS=http://localhost:5180,http://127.0.0.1:5180
# Optional: the whsec_ secret the last PUT webhook returned, so a restarted receiver keeps verifying.
# Treat it like the key: never commit it.
# PARTNER_WEBHOOK_SECRET=
# For the webhook scenarios against a real API: a public https URL that forwards to the listen port here.
# PARTNER_WEBHOOK_URL=
# PARTNER_WEBHOOK_LISTEN_PORT=4020
